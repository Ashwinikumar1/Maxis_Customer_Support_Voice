# =============================================================================
# Maxis voice agent - single config file (local run AND ./deploy.sh read this)
# Copy to .env and adjust. Never commit .env.
# =============================================================================

# --- Vertex AI (Gemini Live). Local auth: `gcloud auth application-default login`
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=alpha-code-461805
GOOGLE_CLOUD_LOCATION=us-central1

# --- Agent
VOICE_AGENT_MODEL=gemini-3.8-live
VOICE_NAME=Kore
# BCP-47 speech language, e.g. en-US or ms-MY. Empty = model auto-detects.
LANGUAGE_CODE=
# Languages in the call, as BCP-47 hints for the input/output transcripts
TRANSCRIPTION_LANGUAGE_CODES=en-US,ms-MY
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# --- FAQ: ADK VertexAiSearchTool (Gemini Live grounding) on this Vertex AI Search data store
FAQ_DATASTORE_ID=projects/mxs-maxisapp-prd/locations/global/collections/default_collection/dataStores/voicebot-maxis-roaming-faq_1782955089227

# --- Transcript dump (one JSON per session). Empty GCS_BUCKET = save to ./transcripts/
GCS_BUCKET=alpha-code-461805-voice-transcripts
GCS_LOG_PREFIX=VoiceAgentLogs

# --- OpenTelemetry -> Google Cloud (traces: Cloud Trace, metrics: Cloud Monitoring,
# logs: Cloud Logging). Docker image/deploy force OTEL_TO_CLOUD=true.
OTEL_TO_CLOUD=false
OTEL_SERVICE_NAME=maxis-voice-agent
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false   # true = caller speech in spans (PII)

# --- Local server (Cloud Run sets HOST/PORT itself)
HOST=127.0.0.1
PORT=8080

# --- Cloud Run deploy (used only by ./deploy.sh)
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=maxis-voice-agent
CLOUD_RUN_SERVICE_ACCOUNT=maxis-voice-agent
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=5

# --- Maxis agent gateway (required: every roaming / WhatsApp tool calls it; no mocks)
# Staging: https://voicebot-cx-studio-agent-gateway-stg-uk6ub3gyvq-as.a.run.app
# Prod:    https://voicebot-cx-studio-agent-gateway-uk6ub3gyvq-as.a.run.app
GATEWAY_URL=https://voicebot-cx-studio-agent-gateway-stg-uk6ub3gyvq-as.a.run.app
# google_id_token (Maxis Cloud Run gateway behind IAM) or none. On Cloud Run the
# runtime service account needs roles/run.invoker on the gateway; locally the
# token comes from `gcloud auth print-identity-token` (optionally impersonating
# GATEWAY_IMPERSONATE_SA, which needs roles/iam.serviceAccountTokenCreator).
GATEWAY_AUTH=google_id_token
GATEWAY_IMPERSONATE_SA=
# Optional extra x-api-key header for gateways that use one (Secret Manager in prod)
GATEWAY_API_KEY=
# Staging backends can be slow; the voice agent apologises and offers a person on timeout.
GATEWAY_TIMEOUT_S=15
# Keyboard clicks while a tool runs or ADK transfers between agents. false = silence
BRIDGE_SOUND=true

# --- /ces voice endpoint (channels/ces_bridge.py): the ONLY way to call the agent.
# Callers: Genesys via the ces-genesys-adapter, and the test client (../client).
# The caller's number comes from the CES variables (msisdn / ani / caller_id).
# Both authenticate with this Bearer token (the adapter reads it from its
# AUTH_TOKEN_SECRET_PATH secret: {"access_token","expiry"}).
# Local only: the token itself (>= 32 chars) or the secret's JSON. On Cloud Run leave
# empty and set CES_BRIDGE_TOKEN_SECRET instead (deploy.sh mounts it from Secret Manager).
CES_BRIDGE_TOKEN=
CES_BRIDGE_TOKEN_SECRET=
# First "caller" turn sent on session_start so the agent greets immediately.
CES_BRIDGE_KICKSTART_TEXT=Hello
# true = send transcripts / tool calls to a test client that asks for them
# (variables.debug_events=true). PII on the wire: keep false on the production service.
CES_DEBUG_EVENTS=true

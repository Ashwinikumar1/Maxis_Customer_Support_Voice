# =============================================================================
# Maxis voice agent - the one settings file
# =============================================================================
# Who reads it:  the local server (server.py / `python -m observability`), the test scripts,
#                and ./deploy.sh, which passes these values to Cloud Run as environment variables.
# How to use it: `scripts/dev.sh setup` creates .env from this file, or adds whatever your .env
#                is missing without changing your values. Never commit .env: it is git-ignored
#                and never copied into the container image.
# Format:        KEY=value, one per line, no quotes needed. The explanation is ALWAYS on the
#                comment lines above a setting (never after the value). Lines starting with
#                "# KEY=" are optional settings: remove the "# " to use one.
# Empty values:  KEY= (nothing after "=") means "use the default" stated in its comment.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Google Cloud and the model
# -----------------------------------------------------------------------------

# Use Vertex AI (Google Cloud) for Gemini, not the consumer Gemini API with an API key.
#   Values: True | False.  Keep True: the service authenticates with Google Cloud credentials
#   (locally `gcloud auth application-default login`, on Cloud Run its service account).
GOOGLE_GENAI_USE_VERTEXAI=True

# The Google Cloud project that pays for and hosts everything: Gemini, Vertex AI Search,
# Cloud Run, Cloud Storage, traces, logs.
#   Change it to your own project ID (Cloud console > project picker). Required.
GOOGLE_CLOUD_PROJECT=alpha-code-461805

# Region of the Gemini Live endpoint: us-central1, where gemini-3.8-live works
# (the original setting). asia-southeast1 was tried on 22 Oct 2026 and failed:
# every call ended at once with "Publisher model .../locations/asia-southeast1/
# .../gemini-3.8-live was not found" (WebSocket 1008).
# Trade-off: the server runs in Singapore (CLOUD_RUN_REGION) but streams audio to
# Gemini in the US, adding a US round trip to each turn - visible in the
# voice.time_to_first_audio metric. Move this closer only after Google confirms
# the model is served in that region for this project.
# Note: regional endpoints do not by themselves guarantee data residency.
# It is also a recorded exception in security/policy_checks/policy.json (region_exceptions):
# everything else targets asia-southeast1. The build fails for a region not listed there.
GOOGLE_CLOUD_LOCATION=us-central1

# The Gemini Live model: the real-time speech-to-speech model that listens and talks.
# Model pinning (AI-01, AG-12): use one exact model ID per release, and change it only in a
# reviewed change. security/policy_checks/policy.json lists the approved IDs and the build fails
# for any other. Vertex AI publishes gemini-3.8-live as a single GA version (released
# 2026-09-24, retirement no earlier than 2027-09-25) with no dated variant, so this ID is the pin;
# check the model versions page before each release for a retirement date.
# The server logs the model at start-up, so each revision's logs show what it ran.
VOICE_AGENT_MODEL=gemini-3.8-live

# The voice the caller hears: one of Gemini's prebuilt voices (e.g. Kore, Puck, Charon, Aoede).
#   Default if missing: Kore. Change it to try another voice; no other setting depends on it.
VOICE_NAME=Kore

# Time zone used for the greeting ("Good morning") when the browser doesn't send its own.
# Roaming dates are always worked out in Malaysia time, whatever this says.
#   Any IANA time zone name. Default if missing: Asia/Kuala_Lumpur.
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# Optional: the text model the scenario runner (scripts/run_scenarios.py) uses to drive the agent
# with typed turns. It tests routing and tool use, not audio. Default: gemini-2.5-flash.
# TEXT_TEST_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# 2. Routing between the agents (see voice_assistant/prompts.py)
# -----------------------------------------------------------------------------

# Which agent answers roaming questions.
#   faq_first : design v0.3 section 4.1. General and how-to roaming questions ("which passes
#               are there?", "how do I turn roaming on?") are answered from the FAQ; the roaming
#               agent only does actions and checks on the caller's own line. (default)
#   specialist: like the production CX Agent Studio bot / design v0.2. Everything about roaming
#               goes to the roaming agent, which answers prices from the live gateway.
ROUTING_MODE=faq_first


# -----------------------------------------------------------------------------
# 3. Agent gateway: where the roaming and WhatsApp tools send their requests
#    (API specs in CustomerDocs/adk-handover-pack/05-tool-api-specs)
# -----------------------------------------------------------------------------

# Which gateway the roaming tools call.
#   mock                  : the built-in mock gateway with DEMO DATA (mock_gateway/): invented passes,
#                           prices and test callers. Default until Maxis shares its gateway.
#   http://127.0.0.1:8090 : the same mock over real HTTP (`scripts/dev.sh mock`), to test the HTTP path.
#   https://<gateway>     : Maxis's real gateway. Requests carry a Google ID token, so the runtime
#                           service account needs roles/run.invoker on the gateway service.
# Several safety defaults depend on this: test callers, write tools and the per-call write limit
# are only relaxed while this is "mock".
GATEWAY_URL=mock

# How requests to the gateway are authenticated.
#   auto     : a Google ID token for https:// URLs, nothing for the mock or http:// (default)
#   id_token : always send a Google ID token
#   none     : never send one
GATEWAY_AUTH=auto

# Seconds to wait for one gateway answer before treating it as a failure.
# buyPass can legitimately take ~20 s while roaming is being switched on, so keep it above that.
#   Default if missing: 30.
GATEWAY_TIMEOUT_S=30

# Optional: the audience for the gateway's ID token, if it differs from GATEWAY_URL
# (e.g. a custom domain in front of Cloud Run). Default: GATEWAY_URL.
# GATEWAY_AUDIENCE=https://voicebot-gateway-xxxxx.a.run.app


# -----------------------------------------------------------------------------
# 4. Browser test client (the page at http://127.0.0.1:8080)
# -----------------------------------------------------------------------------

# Show the "Test caller" picker, so a browser call can pretend to come from a demo line
# (principal with share lines, traveller, prepaid, withheld number...). The browser has no
# caller ID of its own; Genesys will pass the real calling number later.
#   true | false. Default: true. Honoured ONLY with GATEWAY_URL=mock: against a real gateway the
#   picker is always off, so nobody can act on a real line from a browser.
ALLOW_TEST_CALLERS=true

# What a test caller is allowed to do (the security tool policy's verification level).
#   1 = look-ups only (what a real caller ID gives without an OTP)
#   2 = can also buy passes and switch roaming (default; production would need an OTP)
#   Mock gateway only.
TEST_CALLER_VERIFICATION_LEVEL=2

# Start every call with the test caller's demo account as originally seeded (no passes bought,
# roaming as it was), so the same demo script works every time.
#   true | false. Default: true. Applies to the built-in mock only.
MOCK_RESET_ON_CALL=true

# Whether the mock lists active and past passes too, not only scheduled ones.
#   true  : all passes (default; needed for the "my pass isn't working" and refund demos)
#   false : scheduled passes only, like the production gateway today (it has no history API yet)
MOCK_PASS_HISTORY=true


# -----------------------------------------------------------------------------
# 5. FAQ knowledge base
# -----------------------------------------------------------------------------

# The Vertex AI Search app (engine) that holds the Maxis FAQ; search_knowledge_base returns its
# top 3 snippets. Find it in the console under AI Applications > Apps > the app's ID.
#   Change it when you use your own project's search app. Required for FAQ answers.
FAQ_SEARCH_ENGINE_ID=maxis-faq-search-app_1792223644923


# -----------------------------------------------------------------------------
# 6. Transcripts (one JSON file per call) and personal-data removal
# -----------------------------------------------------------------------------

# How personal data is removed from transcripts before they are stored (design section 7).
# The guardrails' redacting logger always masks IC, phone and card numbers and emails first.
#   none  : add nothing (local debugging only)
#   regex : add nothing beyond the guardrails' local redaction (default)
#   dlp   : also run Cloud DLP (Sensitive Data Protection) on every turn; needs roles/dlp.user
REDACT_TRANSCRIPTS=regex

# With REDACT_TRANSCRIPTS=dlp: the Cloud DLP info types to replace, comma-separated.
# Findings become their type name in the transcript, e.g. [PERSON_NAME].
DLP_INFO_TYPES=PHONE_NUMBER,EMAIL_ADDRESS,CREDIT_CARD_NUMBER,PERSON_NAME,STREET_ADDRESS,PASSPORT

# Cloud Storage bucket for transcripts: gs://<bucket>/<GCS_LOG_PREFIX>/conversation_<id>_<time>.json.
#   Empty: transcripts are saved locally in voice_agent/transcripts/ instead (also the fallback
#   if an upload fails). Keep the bucket private: transcripts are caller conversations.
GCS_BUCKET=alpha-code-461805-voice-transcripts

# Folder (object name prefix) inside GCS_BUCKET. Default if missing: VoiceAgentLogs.
GCS_LOG_PREFIX=VoiceAgentLogs


# -----------------------------------------------------------------------------
# 7. Tracing, metrics and logs (OpenTelemetry -> Cloud Trace, Monitoring, Logging)
# -----------------------------------------------------------------------------

# Send traces, metrics and ADK's logs to Google Cloud.
#   false: nothing is exported (normal for local runs; logs still print).
#   true : export to Cloud Trace / Cloud Monitoring / Cloud Logging. The Docker image and
#          deploy.sh always set true on Cloud Run, whatever this says.
OTEL_TO_CLOUD=false

# The service name traces and metrics are filed under in Google Cloud.
OTEL_SERVICE_NAME=maxis-voice-agent

# Whether ADK copies what the caller and the model said into trace spans.
#   false: never (required: it is personal data, AG-10; the build fails if this is true).
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Optional logging settings (deploy.sh uses these defaults when they are not set here):
#   LOG_FORMAT : json = one structured, trace-linked line per log (default on Cloud Run);
#                text = readable lines (default locally).
#   LOG_LEVEL  : DEBUG | INFO (default) | WARNING | ERROR.
#   OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT : keep NO_CONTENT (no conversation in telemetry).
#   OTEL_SEMCONV_STABILITY_OPT_IN : gen_ai_latest_experimental opts in to Google's newer GenAI
#                attribute names; only after checking dashboards in staging.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Optional switches for the observability add-on (observability/); all default to true.
# Set one to false only to rule it out while debugging.
#   OBS_SESSION_SPANS          : session.id on every span + call metrics
#   OBS_WS_SECURITY_LOGS       : a WARNING log for every rejected WebSocket (bad origin, failed sign-in)
#   OBS_FAQ_TRACING            : span, log and metric for each FAQ search
#   OBS_GATEWAY_TRACING        : span and metric for each roaming-tool gateway call
#   OBS_SIGTERM                : clean shutdown on Cloud Run's SIGTERM (calls closed, transcripts saved)
#   OBS_SHUTDOWN_FLUSH_AFTER_S : seconds after SIGTERM before telemetry is force-flushed (default 7)
# OBS_SESSION_SPANS=true
# OBS_WS_SECURITY_LOGS=true
# OBS_FAQ_TRACING=true
# OBS_GATEWAY_TRACING=true
# OBS_SIGTERM=true
# OBS_SHUTDOWN_FLUSH_AFTER_S=7

# --- Trace sampling [Observability #13]: which calls get a full trace in Cloud Trace.
# Default: EVERY call (parentbased_always_on), so any complaint can be investigated.
# Why 100% is right at Maxis scale (estimate, Oct 2026):
#   ~10.8M subscribers (9.98M mobile + 813k home, Maxis Q2 2026 results); assuming
#   0.03-0.15 calls answered by the agent per subscriber per month = 0.3M-1.6M calls,
#   at ~20 spans per call = 6.5M-32M spans/month. Cloud Trace: $0.20 per million spans,
#   first 2.5M free (https://cloud.google.com/stackdriver/pricing) = about $1-6/month.
# Revisit only if volume grows ~10x (about $64/month at 16M calls). To sample instead:
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio
#   OTEL_TRACES_SAMPLER_ARG=0.1        (keeps 10% of calls, each with ALL its spans)
# Metrics and log lines stay complete when sampling: only full traces are dropped.
# Standard OpenTelemetry settings, read by the SDK when ADK creates its tracer.
OTEL_TRACES_SAMPLER=parentbased_always_on


# -----------------------------------------------------------------------------
# 8. Local server
# -----------------------------------------------------------------------------

# Address the server listens on. 127.0.0.1 = only this computer can connect (keep it for local
# runs). Cloud Run sets 0.0.0.0 itself. Default if missing: 127.0.0.1.
HOST=127.0.0.1

# Port for the page and the voice WebSocket. Cloud Run sets PORT itself. Default: 8080.
PORT=8080

# Web pages allowed to open the voice WebSocket (protection against other sites hijacking it),
# comma-separated. Must match the address you open in the browser. deploy.sh sets this to the
# Cloud Run URL automatically.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080


# -----------------------------------------------------------------------------
# 9. Cloud Run deploy (read only by ./deploy.sh)
# -----------------------------------------------------------------------------

# Safety catch: deploy.sh only runs when this is "dev" (personal dev projects). Test and
# production are deployed by the pipeline (security/ci/cloudbuild-deploy.yaml), never by hand.
DEPLOY_ENV=dev

# Region the Cloud Run service runs in.
# Singapore: no Malaysia region exists for Cloud Run yet (checked Oct 2026,
# https://docs.cloud.google.com/run/docs/locations). Tier 2 pricing applies.
# It must be in security/policy_checks/policy.json approved_regions, or the build fails.
CLOUD_RUN_REGION=asia-southeast1

# Name of the Cloud Run service (also part of its URL).
CLOUD_RUN_SERVICE=maxis-voice-agent

# Name (not email) of the runtime service account deploy.sh creates and grants least-privilege
# roles to: Vertex AI, Vertex AI Search, telemetry writers, the transcript bucket, DLP if used.
CLOUD_RUN_SERVICE_ACCOUNT=maxis-voice-agent

# Instances always kept running. 1 avoids a cold start on the first call (costs a little even
# when idle); 0 is cheapest for a dev project nobody is calling.
CLOUD_RUN_MIN_INSTANCES=1

# Most instances Cloud Run may start (each takes up to 20 calls). With GATEWAY_URL=mock set 1
# for demos: the mock's demo accounts live in each instance's memory, so a purchase and a later
# "what passes do I have?" must land on the same instance.
CLOUD_RUN_MAX_INSTANCES=5

# true  : anyone with the URL can open the page and start a call (demo only; spends Gemini quota)
# false : no unauthenticated access; use with the load balancer and IAP from security/terraform
CLOUD_RUN_PUBLIC=true

# Where traffic may come from.
#   all                                : straight from the internet (demo)
#   internal-and-cloud-load-balancing  : only through the load balancer, once security/terraform's
#                                        edge (load balancer + IAP) is up
CLOUD_RUN_INGRESS=all


# -----------------------------------------------------------------------------
# 10. Security guardrails (voice_agent/guardrails)
#     Values for shared environments come from `terraform output app_env` in security/terraform/live.
#     Empty = that control is off; the tool policy, safety filters and local redaction are always on.
# -----------------------------------------------------------------------------

# Model Armor template that screens what the CALLER says for prompt injection and harmful content.
#   Full name: projects/<project>/locations/<region>/templates/<id>. Empty = not used.
MODEL_ARMOR_PROMPT_TEMPLATE=

# Model Armor template that screens what the AGENT says. Same format; empty = not used.
MODEL_ARMOR_RESPONSE_TEMPLATE=

# What a Model Armor match does.
#   inspect : log it and raise the injection flag (write tools off for the rest of the call),
#             but let the call go on (default; use for the first weeks)
#   block   : the same, and also replace the turn with a refusal
MODEL_ARMOR_MODE=inspect

# Optional: how often the agent's speech is screened. sentence (default) = at each sentence end
# or every 200 characters; chunk = every streamed fragment (earliest block, highest cost).
# MODEL_ARMOR_OUTPUT_SCREENING=sentence

# Sensitive Data Protection (DLP) templates for transcripts, set together:
#   DLP_INSPECT_TEMPLATE    : what to find (names, addresses, passports...)
#   DLP_DEIDENTIFY_TEMPLATE : how to replace it
# Both set = every transcript goes through DLP before upload. Empty = local redaction only.
DLP_INSPECT_TEMPLATE=
DLP_DEIDENTIFY_TEMPLATE=

# Gemini's own content filters (hate, harassment, sexual, dangerous content).
#   BLOCK_MEDIUM_AND_ABOVE (default) | BLOCK_LOW_AND_ABOVE (stricter). Anything weaker is ignored
#   and the default is used (guardrails/safety.py).
SAFETY_BLOCK_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Kill switch for tools that change a caller's line (buyPass, switchRoaming).
#   Empty (default): follows the gateway - ON with GATEWAY_URL=mock (demo data, nothing real
#   changes), OFF with a real gateway until caller verification exists.
#   true / false: forces it. Set false to switch account changes off (also to demo the refusal).
WRITE_TOOLS_ENABLED=

# How many account changes (purchases, roaming switches) one call may make.
#   Empty (default): 3 with the mock gateway, 1 (phase 1 security baseline) with a real gateway.
#   A confirmed request that changed nothing (roaming still switching on, a duplicate) doesn't count.
MAX_WRITES_PER_CALL=

# Hard limit on one call's length, in seconds. Default: 1800 (30 minutes, the security baseline's
# maximum in security/policy_checks/policy.json).
MAX_SESSION_SECONDS=1800

# End the call after this many seconds in which nobody spoke (caller or agent).
#   Default: 120. 0 = off, but the security checks require a value from 1 to 300 here.
SILENCE_TIMEOUT_SECONDS=120

# How loud a microphone frame must be to count as the caller speaking (16-bit RMS).
# Room noise is roughly 50-300; raise it if background noise keeps silent calls open.
#   Default: 500.
SILENCE_RMS_THRESHOLD=500

# Identity check on the voice WebSocket with Identity-Aware Proxy (IAP).
#   Empty (default, local only): callers are anonymous.
#   Set (/projects/<number>/global/backendServices/<id>, from the load balancer): every WebSocket
#   must carry a valid signed IAP header, or it is refused with 401.
IAP_AUDIENCE=

# true = refuse to start when IAP_AUDIENCE is empty. Set true in every shared environment, so a
# missing setting can't silently leave the service open. Default: false.
REQUIRE_IAP=false

# Where to fetch Google's IAP signing keys.
#   Empty (default): Google's public https URL.
#   gs://<bucket>/<object>: a copy kept inside the VPC Service Controls perimeter
#   (refreshed by security/jobs/iap_keys_mirror).
IAP_KEYS_URL=

# Database for conversation state, so a call survives a server restart (e.g. Cloud SQL Postgres:
# postgresql+asyncpg://user:pass@host/db). Empty = in memory (lost on restart).
# Local runs only: deploy.sh reads it from Secret Manager (SESSION_DB_URL_SECRET), never from here.
SESSION_DB_URL=

# true = refuse to start without SESSION_DB_URL (set in shared environments). Default: false.
REQUIRE_PERSISTENT_SESSIONS=false

# Key used to hash IDs in security events and logs (HMAC-SHA256), so the same session or line can
# be matched across events without being readable. Empty = an unkeyed hash (fine locally).
# Local runs only: deploy.sh reads it from Secret Manager (SECURITY_EVENT_HMAC_KEY_SECRET).
SECURITY_EVENT_HMAC_KEY=

# Secret Manager secret NAMES (not values) that deploy.sh mounts on Cloud Run:
#   SECURITY_EVENT_HMAC_KEY_SECRET -> becomes SECURITY_EVENT_HMAC_KEY
#   SESSION_DB_URL_SECRET          -> becomes SESSION_DB_URL
# Empty = not mounted.
SECURITY_EVENT_HMAC_KEY_SECRET=
SESSION_DB_URL_SECRET=

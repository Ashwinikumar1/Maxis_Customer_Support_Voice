# =============================================================================
# Maxis voice agent - single config file (local run AND ./deploy.sh read this)
# Copy to .env and adjust. Never commit .env.
# =============================================================================

# --- Vertex AI (Gemini Live). Local auth: `gcloud auth application-default login`
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=alpha-code-461805
# Region of the Gemini Live endpoint. asia-southeast1 (Singapore) is the closest
# region to Kuala Lumpur that offers gemini-3.8-live (checked Oct 2026:
# https://docs.cloud.google.com/gemini-enterprise-agent-platform/resources/locations).
# Keep it the same as CLOUD_RUN_REGION: audio streams continuously between the
# server and Gemini, so both should be close to the callers.
# Note: regional endpoints do not by themselves guarantee data residency.
GOOGLE_CLOUD_LOCATION=asia-southeast1

# --- Agent
VOICE_AGENT_MODEL=gemini-3.8-live
VOICE_NAME=Kore
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# --- FAQ search (Vertex AI Search app; returns top 3 snippets)
FAQ_SEARCH_ENGINE_ID=maxis-faq-search-app_1792223644923

# --- Transcript dump (one JSON per session). Empty GCS_BUCKET = save to ./transcripts/
GCS_BUCKET=alpha-code-461805-voice-transcripts
GCS_LOG_PREFIX=VoiceAgentLogs

# --- OpenTelemetry -> Google Cloud (traces: Cloud Trace, metrics: Cloud Monitoring,
# logs: Cloud Logging). Docker image/deploy force OTEL_TO_CLOUD=true.
OTEL_TO_CLOUD=false
OTEL_SERVICE_NAME=maxis-voice-agent
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false   # true = caller speech in spans (PII)
# Optional (./deploy.sh uses these defaults when unset):
#   LOG_FORMAT=json     json = structured, trace-linked Cloud Logging lines (Cloud Run); text = readable locally
#   LOG_LEVEL=INFO
#   OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
#   OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental   (only after a staging check)

# --- Trace sampling [Observability #13]: which calls get a full trace in Cloud Trace.
# Default: EVERY call (parentbased_always_on), so any complaint can be investigated.
# Why 100% is right at Maxis scale (estimate, Oct 2026):
#   ~10.8M subscribers (9.98M mobile + 813k home, Maxis Q2 2026 results); assuming
#   0.03-0.15 calls answered by the agent per subscriber per month = 0.3M-1.6M calls,
#   at ~20 spans per call = 6.5M-32M spans/month. Cloud Trace: $0.20 per million spans,
#   first 2.5M free (https://cloud.google.com/stackdriver/pricing) = about $1-6/month.
# Revisit only if volume grows ~10x (about $64/month at 16M calls). To sample instead:
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio
#   OTEL_TRACES_SAMPLER_ARG=0.1        (keeps 10% of calls, each with ALL its spans)
# Metrics and log lines stay complete when sampling: only full traces are dropped.
# Standard OpenTelemetry settings, read by the SDK when ADK creates its tracer.
OTEL_TRACES_SAMPLER=parentbased_always_on

# --- Local server (Cloud Run sets HOST/PORT itself; deploy sets ALLOWED_ORIGINS)
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Cloud Run deploy (used only by ./deploy.sh)
# Singapore: no Malaysia region exists for Cloud Run yet (checked Oct 2026,
# https://docs.cloud.google.com/run/docs/locations). Tier 2 pricing applies.
CLOUD_RUN_REGION=asia-southeast1
CLOUD_RUN_SERVICE=maxis-voice-agent
CLOUD_RUN_SERVICE_ACCOUNT=maxis-voice-agent
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=5

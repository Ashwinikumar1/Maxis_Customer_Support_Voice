# =============================================================================
# Maxis voice agent - single config file (local run AND ./deploy.sh read this)
# Copy to .env and adjust. Never commit .env.
# =============================================================================

# --- Vertex AI (Gemini Live). Local auth: `gcloud auth application-default login`
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=alpha-code-461805
GOOGLE_CLOUD_LOCATION=us-central1

# --- Agent
VOICE_AGENT_MODEL=gemini-3.8-live
VOICE_NAME=Kore
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# --- FAQ search (Vertex AI Search app; returns top 3 snippets)
FAQ_SEARCH_ENGINE_ID=maxis-faq-search-app_1792223644923

# --- Transcript dump (one JSON per session). Empty GCS_BUCKET = save to ./transcripts/
GCS_BUCKET=alpha-code-461805-voice-transcripts
GCS_LOG_PREFIX=VoiceAgentLogs

# --- OpenTelemetry -> Google Cloud (traces: Cloud Trace, metrics: Cloud Monitoring,
# logs: Cloud Logging). Docker image/deploy force OTEL_TO_CLOUD=true.
OTEL_TO_CLOUD=false
OTEL_SERVICE_NAME=maxis-voice-agent
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false   # true = caller speech in spans (PII)

# --- Local server (Cloud Run sets HOST/PORT itself; deploy sets ALLOWED_ORIGINS)
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Cloud Run deploy (used only by ./deploy.sh)
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=maxis-voice-agent
CLOUD_RUN_SERVICE_ACCOUNT=maxis-voice-agent
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=5
CLOUD_RUN_PUBLIC=true                     # false = no unauthenticated invoke (use with the load balancer and IAP)
CLOUD_RUN_INGRESS=all                     # internal-and-cloud-load-balancing once security/terraform's edge is up

# --- Guardrails (voice_agent/guardrails). Values from `terraform output app_env` in security/terraform/live.
# Empty = that control is off; the tool policy, safety settings and local redaction are always on.
MODEL_ARMOR_PROMPT_TEMPLATE=              # projects/<p>/locations/<r>/templates/<id>
MODEL_ARMOR_RESPONSE_TEMPLATE=
MODEL_ARMOR_MODE=inspect                  # inspect = log and flag; block = also stop the turn
DLP_INSPECT_TEMPLATE=                     # Sensitive Data Protection on transcripts before upload
DLP_DEIDENTIFY_TEMPLATE=
SAFETY_BLOCK_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
WRITE_TOOLS_ENABLED=false                 # kill switch for tools that change a caller's line
MAX_SESSION_SECONDS=1800
SESSION_DB_URL=                           # local only; deploy reads it from SESSION_DB_URL_SECRET
REQUIRE_PERSISTENT_SESSIONS=false
SECURITY_EVENT_HMAC_KEY=                  # local only; deploy reads it from SECURITY_EVENT_HMAC_KEY_SECRET
SECURITY_EVENT_HMAC_KEY_SECRET=           # Secret Manager secret names (deploy only)
SESSION_DB_URL_SECRET=

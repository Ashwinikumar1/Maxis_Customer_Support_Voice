# Copy of ces-genesys-adapter-stg pointing to our Cloud Run ADK voice agent (maxis-voice-agent).
# Copy this file to .env and adjust if needed, then run:  ./deploy.sh

GOOGLE_CLOUD_PROJECT=mxs-maxisapp-prd
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=ces-genesys-adapter-adk-stg

# Service account for the adapter (defaults to the same compute SA used by ces-genesys-adapter-stg;
# replace with a dedicated SA e.g. ces-adapter-adk-stg@mxs-maxisapp-prd.iam.gserviceaccount.com when created).
CLOUD_RUN_SERVICE_ACCOUNT=657431854992-compute@developer.gserviceaccount.com

# Scaling & resources (mirrors ces-genesys-adapter-stg)
CLOUD_RUN_CPU=1
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=50
CLOUD_RUN_CONCURRENCY=80
CLOUD_RUN_TIMEOUT=3600

# Backend WebSocket URL of our deployed ADK voice agent (must end with /ces/ - adapter appends location "us")
CES_WS_URL=wss://maxis-voice-agent-657431854992.us-central1.run.app/ces/

# Shared token secret in Secret Manager (full resource path without /versions/latest; adapter appends /versions/latest)
AUTH_TOKEN_SECRET_PATH=projects/mxs-maxisapp-prd/secrets/voice-agent-ces-token

# Genesys Audio Connector secrets in Secret Manager (mounted as env vars)
GENESYS_API_KEY_SECRET=genesys-audioconnector-api-key-stg
GENESYS_CLIENT_SECRET=genesys-audioconnector-client-secret-stg

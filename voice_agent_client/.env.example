# =============================================================================
# Test client (local only). Copy to .env and adjust. Never commit .env.
# =============================================================================

# Server's /ces endpoint (any location suffix works, e.g. /ces/test).
#   local server : ws://127.0.0.1:8080/ces/local
#   Cloud Run    : wss://maxis-voice-agent-<project-number>.<region>.run.app/ces/test
SERVER_URL=ws://127.0.0.1:8080/ces/local

# The SAME token the server checks (server CES_BRIDGE_TOKEN / the adapter's secret):
# the raw token (>= 32 chars) or the secret's JSON {"access_token": "...", "expiry": ...}.
# For Cloud Run:  gcloud secrets versions access latest --secret <CES_BRIDGE_TOKEN_SECRET>
CES_BRIDGE_TOKEN=

# Where the browser UI is served (loopback only).
CLIENT_HOST=127.0.0.1
CLIENT_PORT=8090
